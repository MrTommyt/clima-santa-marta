# Copy to .env and adjust. `.env` is gitignored — never commit real credentials.

# --- PostgreSQL (one instance, three databases: clima, airflow, mlflow) ---
POSTGRES_USER=clima
POSTGRES_PASSWORD=clima-local-dev
POSTGRES_DB=clima
POSTGRES_PORT=5432

# --- MinIO (raw data lake + MLflow artifacts) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-local-dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Kafka ---
KAFKA_HOST_PORT=29092

# --- Redis ---
REDIS_PORT=6379

# --- MLflow ---
MLFLOW_PORT=5000

# --- Airflow ---
AIRFLOW_PORT=8081
# Set to your host UID (`id -u`) so the bind-mounted dags/ dir is writable
# by both you and the container. Default image UID is 50000.
AIRFLOW_UID=1000
